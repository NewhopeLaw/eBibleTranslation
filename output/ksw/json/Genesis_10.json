{
 "book": "Genesis",
 "chapter": 10,
 "lang": "ksw",
 "verses": {
  "1": "ဒီးအံၤမ့ၢ်စီၤနိအၤစီၤၡံ, ဒီးစီၤဃၣ်, ဒီးလၢစီၤယဖၤလီၤ. ဒီးစီၤယၤဖၤမၤဆံးဆံးမုၣ်လၢမုၢ်ဆ့ၣ်နီၤန့ၣ်,",
  "2": "ဒီးစီၤယၤဖၤစီၤစီၤဃၤမ့ၤ, ဒီးစီၤမဃၤ, ဒီးစီၤမဒၤ, ဒီးစီၤယၤဝၣ်, ဒီးစီၤတူးဘၤ, ဒီးစီၤမ့ၡး, ဒီးစီၤတၤရၤလီၤ.",
  "3": "ဒီးစီၤဃူမၢ်စီၤစီၤအၤရှံးနး, ဒီးစီၤရၤဖၤ, ဒီးစီၤတဃၤမါလီၤ.",
  "4": "ဒီးစီၤယၤဝၣ်စီၤစီၤအၤလၤစၤ, ဒီးစီၤတၤရၡၤ, ဒီးစီၤကံးတၤ, ဒီးစီၤဒၤဒၣ်ယၤလီၤ.",
  "5": "ဒီးလၢတၢ်အံၤအဃိဒီး, ပှၤကလုာ်တဖၣ်ဟဲက့ၤကဒါက့ၤဆူကီၢ်တဖၣ်အပူၤ, တဂၤဆူအကီၢ်ပူၤ, ဒီးစီၤအၤဟရိၣ်ဆူအဟံၣ်ပူၤ, ဒီးစီၤအၤဃးဆူအလီၢ်ပူၤလီၤ.",
  "6": "ဒီးစီၤဃၣ်အဖိခွါမ့ၢ်စီၤဃူၡၤ, ဒီးစီၤအံၣ်စရ့လး, ဒီးစီၤဖူး, ဒီးစီၤကၤနၣ်လီၤ.",
  "7": "ဒီးစီၤဃူၡးစီၤၡဘၤ, ဒီးစီၤဃဝီလၤ, ဒီးစီၤၡဘၤတၤ, ဒီးစီၤရၤမါ, ဒီးစီၤရၤဘၤတၤလီၤ. ဒီးစီၤရၤမါစီၤၡဘၤ, ဒီးစီၤဒၤဒၣ်လီၤ.",
  "8": "ဒီးစီၤကူၡးဖှံစီၤနးမၤရၤ, ဒီးစီၤနးမၤရၤမ့ၢ်ပှၤလုၢ်တၢ်အဒိၣ်လၢဟီၣ်ခိၣ်ချၢလီၤ.",
  "9": "ဒီးမ့ၢ်ပှၤထိၣ်ကိၢ်တၢ်ဂီၤလၢယွၤအပူၤလီၤ. မၤသးဒ်န့ၣ်ဒီးစံးဝဲဒၣ်, ပှၤထိၣ်ကိၢ်တၢ်ဂီၤလၢယွၤအပူၤဒ်စီၤနိမ့ၤရၤအသိးလီၤ.",
  "10": "ဒီးအကီၢ်အခိၣ်န့ၣ်မ့ၢ်ဘံၣ်စရ့လး, ဒီးဧၤရၤ, ဒီးဧၤကး, ဒီးကၤလနၤ, လၢကီၢ်ၡၤနၣ်ပူၤလီၤ.",
  "11": "ဒီးစီၤအၤရှူၤဟဲဝဲလၢကီၢ်အံၤ, ဒီးမၤထီၣ်နးယၤ, ဒီးရဃၤဘၤဧၤရၤ, ဒီးကၤလၤလီၤ.",
  "12": "ဒီးရၤၡၣ်လၢနံးနိအၤဒီးကၤလၤအပူၤလီၤ. (အဝဲဒၣ်န့ၣ်မ့ၢ်ကီၢ်ဒိၣ်လီၤ. )",
  "13": "ဒီးစီၤအံၣ်စရ့လးအဖိခွါမ့ၢ်စီၤလၤဒၤ, ဒီးစီၤအၤနယၤ, ဒီးစီၤလဃၤဘၤ, ဒီးစီၤနဖတၤယၤ,",
  "14": "ဒီးစီၤပထရူၡံ, ဒီးစီၤကၤစလၤဃၣ်, (ပှၤဖၤရိၤဖိဟဲက့ၤဆူအီၤ, ) ဒီးစီၤကၤဖၤတံၣ်,",
  "15": "ဒီးစီၤကၤနၣ်ဖှံစီၤၡၤဒၣ်, ဒီးစီၤဃၤသး,",
  "16": "ဒီးယၤဘၤဖိ, ဒီးဧၤမ့ၤဖိ, ဒီးကၤရကၤဖိ,",
  "17": "ဒီးပှၤဃံဖိ, ဒီးပှၤအၤရးဖိ, ဒီးပှၤၡံဖိ,",
  "18": "ဒီးပှၤဧၤရဝၤဖိ, ဒီးပှၤစမၤရၤဖိ, ဒီးပှၤဃမၤဖိလီၤ. ဒီးလၢခံန့ၣ်ပှၤကၤနၣ်ဖိအကီၢ်တဖၣ်အိၣ်သယိာ်လီၤ.",
  "19": "ဒီးပှၤကၤနၣ်ဖိအကီၢ်ပူၤမ့ၢ်လၢၡၤဒၣ်ဆူဃရၤရၤ, ဒီးဆူကၤစၤ, ဒီးဆူစၤဒၤ, ဒီးဆူဃမါရၤ, ဒီးဆူဧးဒၤမါ, ဒီးဆူစဘၤဧၣ်, ဒီးဆူလၤရှၤလီၤ.",
  "20": "ပှၤအံၤမ့ၢ်စီၤဃၣ်အဖိခွါ, ဒ်အကလုာ်တဖၣ်အသိး, ဒ်အတၢ်ကတိၤအသိး, ဒ်အကီၢ်တဖၣ်အသိး, ဒ်အကီၢ်တဖၣ်အသိးလီၤ.",
  "21": "ဒီးစီၤရှ့ၤမ့းမ့ၢ်စီၤယၤဖၤအပၢ်စီၤဧ့ဘၤ, ဒီးစီၤယံးဖၤအဖိခွါခဲလၢာ်အပၢ်လီၤ.",
  "22": "ဒီးစီၤရှံးစီၤစီၤအၤလၣ်, ဒီးစီၤအၤရှူၤ, ဒီးစီၤအၤရပးၡး, ဒီးစီၤလၤဒၤ, ဒီးစီၤအၤရၣ်လီၤ.",
  "23": "ဒီးစီၤစၤရၣ်အဖိခွါမ့ၢ်စီၤဧူးၤစၤ, ဒီးစီၤဃူၤလၤ, ဒီးစီၤကၤတၤ, ဒီးစီၤမၤရှၤလီၤ.",
  "24": "ဒီးစီၤအၤရပးၡးဖှံစီၤၡၤလၤ, ဒီးစီၤၡၤလၤဖှံစီၤဧၤဘၤ,",
  "25": "ဒီးစီၤဧ့ဘၤမ့ၢ်ဖိခွါခံဂၤလီၤ. စီၤဖၤရၤမ့ၢ်စီၤအံၣ်စရ့လးအပၢ်လီၤ. ဘၣ်ဆၣ်ဒီးလၢစီၤပၤအနံၣ်န့ၣ်ဟီၣ်ခိၣ်အိၣ်ဖှိၣ်ရိဖှိၣ်လီၤ. ဒီးစီၤယံးကၡၣ်မ့ၢ်အမုၣ်လီၤ.",
  "26": "ဒီးစီၤယးကၤတၣ်ဆံးခိၣ်စီၤအၤမဒး, ဒီးစီၤၡၤလဖၤ, ဒီးစီၤဃၤစၤမဝၤ, ဒီးစီၤယရၤ,",
  "27": "ဒီးစီၤဃၤဒရၣ်, ဒီးစီၤအ့စၤ, ဒီးစီၤဒကၤလၤ,",
  "28": "ဒီးစီၤဧူးဘၤ, ဒီးစီၤအဘံမဧၤ, ဒီးစီၤၡဘၤ,",
  "29": "ဒီးစီၤဧ့ဖၤ, ဒီးစီၤဃဝီလၤ, ဒီးစီၤယၤဘၤလီၤ. ပှၤအံၤခဲလၢာ်မ့ၢ်စီၤယကၤတၣ်အဖိခွါလီၤ.",
  "30": "ဒီးပှၤအိၣ်ဖှိၣ်ရိဖှိၣ်န့ၣ်အိၣ်ဖှိၣ်ရိဖှိၣ်လၢမၤရှၤဆူစဖၤ, လၢကစၢၢ်လၢကီၢ်ကိာ်ပူၤလီၤ.",
  "31": "ပှၤအံၤမ့ၢ်စီၤၡံဖိ, ဒ်အပၢ်တဖၣ်အသိးန့ၣ်, ဒ်အတၢ်ကတိၤအသိးန့ၣ်, လၢအကီၢ်ပူၤ, ဒ်အကီၢ်တဖၣ်အသိးန့ၣ်လီၤ.",
  "32": "ပှၤတဖၣ်န့ၣ်မ့ၢ်စီၤနိအၤစီၤၡံၡၣ်တဖၣ်, ဒ်ပှၤအိၣ်ဘှံးတဖၣ်အသိး, ဒ်ပှၤကလုာ်တဖၣ်အသိးလီၤ. ဒီးလၢအီၤန့ၣ်ပှၤကလုာ်တဖၣ်အိၣ်ဘှံးဝဲလၢဟီၣ်ခိၣ်ချၢလၢထံထီၣ်ထီလီၤ."
 },
