{
 "book": "Psalms",
 "chapter": 60,
 "lang": "ksw",
 "verses": {
  "1": "ဘၣ်ဃးဒီးရှူၡၣ်ဧဒူး, လၢစီၤဒၤဝံးအပျုၤ, ဒ်သိးအကအုၣ်က့ၤခီၣ်က့ၤတၢ်အဂီၢ်,",
  "2": "ဒီးဒုးကဲထီၣ်စူၤရံနဃၤရ့လး, ဒီးစူၤရံၡဘၤ, ဒီးစီၤယၤအၤဟဲက့ၤဝဲ, ဒီးကျီကွံာ်ပှၤဧၤဒံၣ်ဖိတဆံခံကထိလၢကစၢၢ်ကလိအခိၣ်လီၤ.",
  "3": "ယွၤဧၢ, နစွါကွံာ်ပှၤ, နဒုးကျဲကွံာ်ပှၤ, နသးကိၢ်နသးဂီၤ, ဒီးယသးကညီၤဘၣ်နၤဘၣ်.",
  "4": "နမၤကိၢ်တၢ်ဂီၤဟီၣ်ခိၣ်, နမၤကိၢ်တၢ်ဂီၤအီၤ, နမၤကိၢ်တၢ်ဂီၤအကျိၤအကျဲလီၤ. ယွၤဧၢ, နမၤကဘျံးကဘျၣ်အီၤလီၤ.",
  "5": "နပာ်နပှၤလၢတၢ်ဒုၣ်ဒွဲၣ်အပူၤ, နဟ့ၣ်ပှၤစပံးထံလၢတၢ်ဒုၣ်ဒွဲၣ်အပူၤလီၤ.",
  "6": "နပာ်တၢ်အုၣ်က့ၤခီၣ်က့ၤလၢတၢ်ပျံၤတၢ်ဖုးအဂီၢ်, ဒ်သိးအကဟဲစိာ်ထီၣ်ကွံာ်လၢကစၢၢ်ကလိလီၤ. စၤလၤ.",
  "7": "ဒ်သိးနပှၤအုၣ်က့ၤခီၣ်က့ၤနသးန့ၣ်ကဟဲက့ၤကဒါက့ၤဒီးနစုခိၣ်, ဒီးနသးကိာ်ယၤတက့ၢ်.",
  "8": "ယွၤစံးဝဲဒၣ်လၢပှၤစီဆှံအပူၤ, ယကသူၣ်ဖှံသးညီ, ဒီးယကပာ်လီၤရှံးက့လး, ဒီးယကမၢလီၤကစၢၢ်ကလိလၢဟံၣ်ပူၤလီၤ.",
  "9": "ကလၤဧၤမ့ၢ်ယတၢ်, ဒီးစီၤမၤနၡၤမ့ၢ်ယတၢ်, ဒီးစီၤအၤဖရိၤမ့ၢ်ယခိၣ်အခိၣ်သပှၢ်တၢၢ်, ဒီးစီၤယူဒၤမ့ၢ်ယစီၤပၤလီၤ.",
  "10": "ပှၤဖၤရိၤဖိစံးဝဲဒၣ်, ယၤဧၢ, ယၤကဒုးဟဲစိာ်ယကူဒီးဧၤဒံၣ်လီၤ.",
  "11": "မ်မတၤဟဲစိာ်ယၤဆူကီၢ်တၢ်ဝးတရံးပူၤလဲၣ်. မ်မတၤဟဲစိာ်ယၤဆူဧၤဒံၣ်ပူၤလဲၣ်.",
  "12": "ယွၤဧၢ, နမၤသံပှၤ, ဒီးလၢနတဟဲထီၣ်ဘၣ်, ယွၤဧၢ, ဒီးပသုးမုၢ်လီၤ.",
  "13": "မၤသးဒ်န့ၣ်ဒီးကူထီၣ်နၤလၢတၢ်ဒုၣ်ဒွဲၣ်အပူၤတက့ၢ်. ဘၣ်ဆၣ်ဒီးပှၤကညီတၢ်အုၣ်က့ၤခီၣ်က့ၤန့ၣ်တတီတလိၤဘၣ်လီၤ.",
  "14": "လၢယွၤန့ၣ်ပကမၤတၢ်ဂ့ၤ, ဒီးကပာ်ပဒုၣ်ပဒါလီၤ."
 },
