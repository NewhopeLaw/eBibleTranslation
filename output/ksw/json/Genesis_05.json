{
 "book": "Genesis",
 "chapter": 5,
 "lang": "ksw",
 "verses": {
  "1": "ဒီးစီၤအၤဟရိၣ်အကလုာ်တဖၣ်န့ၣ်မ့ၢ်အအံၤလီၤ. လၢမုၢ်တနံၤလၢယွၤမၤစီၤအၤဟရိၣ်ဒီး, မၤအီၤဒ်ယွၤအသိးလီၤ.",
  "2": "ဒီးမၤအီၤဖိခွါဒီးဖိခွါ, ဒီးအုၣ်က့ၤခီၣ်က့ၤအီၤ, ဒီးစံးဝဲဒၣ်, စီၤအၤမါ, လၢမုၢ်တနံၤလၢအမၤအီၤန့ၣ်လီၤ.",
  "3": "ဒီးစီၤအၤမါမူဝဲအနံၣ်တကယၤသၢဆံ, ဒီးဆံးထီၣ်ဖိမုၣ်လၢအလိၤဒ်အလိၤအသိး, ဒ်အလိၤအသိးန့ၣ်, ဒီးစံးဝဲဒၣ်, စီၤစၤသးလီၤ.",
  "4": "ဒီးစီၤအၤမါမူဝဲ, ဒီးဆံးကယၤလၢစီၤစၤသးဖှံဝဲန့ၣ်, ဒီးဖှံပှၤဖိခွါဒီးဖိခွါလီၤ.",
  "5": "ဒီးစီၤအၤဟရိၣ်အနံၣ်ခဲလၢာ်မ့ၢ်အနံၣ်ခွံဆံဆံ, ဒီးသံလီၤ.",
  "6": "ဒီးစီၤစၤသးမူဝဲအနံၣ်တဆံလွံၢ်နံၣ်, ဒီးဖှံစီၤဧၤနါၤလီၤ.",
  "7": "ဒီးစီၤစၤသးမူလၢစီၤအၤနံးဖှံဝဲန့ၣ်အနံၣ်လွံၢ်ကယၤနွံနံၣ်, ဒီးဖှံပှၤဖိခွါဒီးဖိမုၣ်လီၤ.",
  "8": "ဒီးစီၤစၤသးအနံၣ်ခဲလၢာ်မ့ၢ်အနံၣ်ခွံကယၤတဆံခံနံၣ်, ဒီးသံလီၤ.",
  "9": "ဒီးစီၤအၤနိၤမူဝဲအနံၣ်ခွံဆံ, ဒီးဖှံစီၤကၤနၣ်လီၤ.",
  "10": "ဒီးစီၤအၤနိၤမူဝဲလၢစီၤကၤနၣ်ဖှံဝဲန့ၣ်အနံၣ်လွံၢ်ကထိတဆံခွံနံၣ်, ဒီးဖှံပှၤဖိခွါဒီးဖိမုၣ်လီၤ.",
  "11": "ဒီးစီၤအၤနါၤအနံၣ်ခဲလၢာ်မ့ၢ်အနံၣ်ခွံကယၤလွံၢ်နံၣ်, ဒီးသံလီၤ.",
  "12": "ဒီးစီၤကၤနၣ်မူဝဲအနံၣ်နွံဆံ, ဒီးဖှံစီၤမဃၤလလၤလီၤ.",
  "13": "ဒီးစီၤကၤနၣ်မူဝဲလၢစီၤမဃၤလဧၤရၤဖှံဝဲန့ၣ်အနံၣ်လွံၢ်ဆံလွံၢ်ဆံ, ဒီးဖှံပှၤဖိခွါဒီးဖိမုၣ်လီၤ.",
  "14": "ဒီးစီၤကၤနၣ်အနံၣ်ခဲလၢာ်မ့ၢ်အနံၣ်ခွံကယၤတဆံ, ဒီးသံလီၤ.",
  "15": "ဒီးစီၤမဃၤလလၤမူဝဲခံဆံဒိၣ်နံၣ်, ဒီးဖှံစီၤယရူၤၡၣ်လီၤ.",
  "16": "ဒီးစီၤမဃၤလလၤမူဝဲလၢစီၤယရူၤၡယၤဖှံဝဲန့ၣ်အနံၣ်လွံၢ်ဆံဆံ, ဒီးဖှံပှၤဖိခွါဒီးဖိမုၣ်လီၤ.",
  "17": "ဒီးစီၤမဃၤလလၤအနံၣ်ခဲလၢာ်မ့ၢ်အနံၣ်ခံဆံကထိဒီးနွံဆံလီၤ. ဒီးသံလီၤ.",
  "18": "ဒီးစီၤယရူၤၡၣ်မူဝဲအနံၣ်တဆံဆံခံနံၣ်, ဒီးဖှံစီၤဧၤနးလီၤ.",
  "19": "ဒီးစီၤယရၤဒးမူဝဲလၢစီၤဃနါၤဖှံဝဲန့ၣ်အနံၣ်လွံၢ်ကထိ, ဒီးဖှံပှၤဖိခွါဒီးဖိခွါလီၤ.",
  "20": "ဒီးစီၤယရူၤၡယၤအနံၣ်ခဲလၢာ်မ့ၢ်အနံၣ်ခွံကထိ, ဒီးဆံဆံခံနံၣ်, ဒီးသံလီၤ.",
  "21": "ဒီးစီၤဟၤနးမူဝဲခံဆံဒိၣ်နံၣ်, ဒီးဖှံစီၤမ့ၤသၡၤလၤလီၤ.",
  "22": "ဒီးစီၤဟၤနါလဲၤဒီးယွၤလၢစီၤမၤသူစၤလၤဆံကယၤ, ဒီးဆံးနံၣ်ဒီးဆံးနံၤ, ဒီးမၤဖှံပှၤဖိခွါဒီးဖိမုၣ်လီၤ.",
  "23": "ဒီးစီၤဟၤနါအနံၣ်ခဲလၢာ်န့ၣ်မ့ၢ်အနံၣ်သၢဆံခွံဆံလီၤ.",
  "24": "ဒီးစီၤဟၤနါလဲၤဝဲဒီးယွၤ, ဒီးတမ့ၢ်ဘၣ်လီၤ. ဘၣ်ဆၣ်ဒီးယွၤဟဲစိာ်အီၤလီၤ.",
  "25": "ဒီးစီၤမၤသၡၤလၤမူဝဲတဆံခံဆံနွံနံၣ်, ဒီးဖှံစီၤလၤမါလီၤ.",
  "26": "ဒီးစီၤမၤသစၤလၤမူဝဲလၢစီၤလၤမါဆံးဆံခံနံၣ်ဒီးဆံးနံၣ်, ဒီးဆံးနံၤပှၤဖိခွါဒီးဖိခွါလီၤ.",
  "27": "ဒီးစီၤမၤသစၤလၤအနံၣ်ခဲလၢာ်မ့ၢ်အနံၣ်ခွံကထိ, ဒီးဆံဆံခွံနံၣ်, ဒီးသံလီၤ.",
  "28": "ဒီးစီၤလၤမါမူဝဲတဆံခံဆံခံနံၣ်, ဒီးဆံးထီၣ်ဖိစီၤယၤကိာ်လီၤ.",
  "29": "ဒီးစံးဝဲဒၣ်, ပှၤအံၤကပာ်ပသူၣ်ဖှံသးညီလၢပတၢ်မၤ, ဒီးလၢပစုအမၤသးဒ်ဟီၣ်ခိၣ်လၢအယွၤမၤသံအီၤအသိးန့ၣ်လီၤ.",
  "30": "ဒီးစီၤလၤမါမူလၢစီၤနိအၤဖှံဝဲန့ၣ်အနံၣ်ခွံဆံနွံဆံ, ဒီးဖှံပှၤဖိခွါဒီးဖိခွါလီၤ.",
  "31": "ဒီးစီၤလၤမါအနံၣ်ခဲလၢာ်မ့ၢ်အနံၣ်နွံနွံဆံနွံနံၣ်, ဒီးသံလီၤ.",
  "32": "ဒီးစီၤနိအၤမ့ၢ်အနံၣ်လွံၢ်ကယၤဒီးဖှံစီၤၡံ, ဒီးစီၤဃၣ်, ဒီးစီၤယၤဖၤလီၤ."
 },
