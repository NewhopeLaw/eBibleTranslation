{
 "book": "Job",
 "chapter": 39,
 "lang": "ksw",
 "verses": {
  "1": "ခဲကနံၣ်အံၤ, ဆၣ်ဖိဖိးဖိးမၤဖှံတၢ်, ဒီးသိဖိးဖိးမၤဖှံတၢ်န့ၣ်နသ့ၣ်ညါဧါ.",
  "2": "နပာ်ဖှိၣ်အနံၣ်ခံဆံလီၤ. နသ့ၣ်ညါအနံၣ်ခံဆံအနံၣ်လီၤ.",
  "3": "နဟ့ၣ်အဖိခွါလၢတၢ်အုၣ်က့ၤခီၣ်က့ၤအပူၤ, ဒီးပာ်ကွံာ်အဖိခွါလၢတၢ်ပျံၤတၢ်ဖုးအပူၤလီၤ.",
  "4": "ဒီးအဖိခွါန့ၣ်မၤကမၣ်တၢ်, ဒီးအိၣ်ဘှီၣ်ကလာ်လၢဟီၣ်ခိၣ်ချၢ, ဒီးဟဲက့ၤဝဲ, ဒီးတဟဲက့ၤဘၣ်ဆူအီၤဘၣ်.",
  "5": "မ့ၢ်မတၤမၤလီၤဃၣ်ကိၢ်ဖိလၢအသးကိာ်ပူၤ, ဒီးမၤလီၤဃၣ်ကိၢ်ဖိအခိၣ်သလုးန့ၣ်မတၤမ့ၢ်မတၤလဲၣ်.",
  "6": "ယကပာ်အဟံၣ်လၢဟီၣ်ခိၣ်ချၢ, ဒီးယပာ်အဟံၣ်လၢထံလၢပူၤလီၤ.",
  "7": "ကစၢၢ်ကလိလၢကီၢ်အသံလီၤ. မတၤနၢၤဘၣ်ပှၤပာ်ကိၣ်အသံလီၤ.",
  "8": "ဃ့ကညးကစၢၢ်ကလိ, ဒီးဒုးဟဲစိာ်တၢ်အိၣ်ဘှံး, ဒီးဟဲစူၢ်က့ၤကွၢ်ဆၢၣ်မဲာ်တၢ်အသီခဲလၢာ်လီၤ.",
  "9": "ကစၢၢ်ကလိမၤနၤဧါ. ဒီးဆိၣ်က့ၤလၢနထံပူၤလဲၣ်.",
  "10": "နပာ်ထီၣ်ထီသိယီၤလၢထံယီၤပူၤဧါ. နပာ်အီၤလၢနထံယီၤပူၤဧါ.",
  "11": "နသ့ၣ်ညါအီၤ, ဒီးပာ်နတၢ်မၤလၢအပူၤ, ဒီးလၢအသူၣ်အုးသးညီအဃိလီၤ.",
  "12": "နမၤလိာ်အီၤဒ်သိးအကဟဲက့ၤကဒါက့ၤနသွံၣ်, ဒီးပာ်ထီၣ်ထီနသွံၣ်န့ၣ်လဲၣ်.",
  "13": "နပာ်ထီၣ်ထီသိဖိအပျုၤလဲၣ်. နပာ်ကိၢ်တၢ်ဂီၤလၢထိၣ်ပူၤလဲၣ်.",
  "14": "ယွၤဧၢ, နပာ်ထီၣ်ထီအကစၢၢ်ကလိလၢဟီၣ်ခိၣ်ချၢ, ဒီးမၤကိၢ်တၢ်ဂီၤအီၤလၢဟီၣ်ခိၣ်ချၢလီၤ.",
  "15": "မၤသးဒ်န့ၣ်ဒီး, မၢလီၤပၢၤတၢ်, ဒ်သိးအကမၤသံအီၤ, ဒီးဒ်သိးအကမၤသယိာ်အီၤ,",
  "16": "အဖိခွါတဖၣ်မၤကမၣ်အီၤ, မၤသးဒ်အသုတသ့ၣ်ညါအီၤအသိးန့ၣ်, ဒီးမၤအသးတတီတလိၤဘၣ်, တမ့ၢ်ဘၣ်အသးဘၣ်.",
  "17": "ဘၣ်ဆၣ်ဒီးယွၤတဟ့ၣ်လီၤဘၣ်အီၤဘၣ်, ဒီးတဟ့ၣ်ဘၣ်အီၤဘၣ်တၢ်သ့ၣ်ညါအစုပူၤဘၣ်.",
  "18": "ဒီးတုၤအဟဲထီၣ်ဆူတၢ်လိၤလၢမုၢ်တနံၤန့ၣ်ဒီး, ပာ်ကိၢ်တၢ်ဂီၤကိၢ်တၢ်ဂီၤ, ဒီးပှၤဟဲစိာ်အီၤန့ၣ်လီၤ.",
  "19": "နဟ့ၣ်ကိၢ်တၢ်ဂီၤဧါ. နပာ်ကိၢ်တၢ်ဂီၤလၢအခိၣ်လဲၣ်.",
  "20": "နမၤက့ၤအီၤဒ်မ့ၣ်အူဖီၣ်အသိးန့ၣ်ဧါ. အခိၣ်သယိာ်မ့ၢ်တၢ်ပျံၤတၢ်ဖုးလီၤ.",
  "21": "ပာ်အစုလၢကစၢၢ်ကလိအပူၤ, သူၣ်ဖှံသးညီလၢအဂံၢ်အဘါအပူၤ, ဒီးဟဲစိာ်ဝဲဆူတၢ်ဆိၣ်ပူၤလီၤ.",
  "22": "ဃ့ကညးတၢ်ပျံၤတၢ်ဖုး, တမ့ၢ်ဘၣ်အသးဘၣ်, ဒီးတဟဲက့ၤကဒါက့ၤဘၣ်လၢနးအဃိဘၣ်.",
  "23": "ကစၢၢ်ကလိ, ဒီးစူၤရံ, ဒီးကစၢၢ်ကဆူးန့ၣ်ပာ်ထီၣ်ထီအီၤလီၤ.",
  "24": "အသးကိၢ်တၢ်ဂီၤ, ဒီးအသးကိၢ်တၢ်ဂီၤန့ၣ်မၤကိၢ်တၢ်ဂီၤဟီၣ်ခိၣ်လီၤ. ဒီးတုၤထးခိၣ်တသံဘၣ်ဒီး, တသ့ၣ်ညါဘၣ်.",
  "25": "ဒီးလၢထးခိၣ်အသံန့ၣ်စံးဝဲဒၣ်, ကိၢ်တၢ်ဂီၤတက့ၢ်. ဒီးဟဲစိာ်တၢ်အုၣ်က့ၤခီၣ်က့ၤလၢအဝၤပူၤ, ပှၤသုးမုၢ်အခိၣ်အသံ, ဒီးတၢ်သုးမုၢ်အသံလီၤ.",
  "26": "နတၢ်ကူၣ်တၢ်ဆးန့ၣ်မၤထီၣ်ထီသိဖိအပျၢ်ဆူကလံၤစိးတက့ၢ်လဲၣ်.",
  "27": "ပာ်ထီၣ်ထီအီၤ, ဒီးပာ်ထီၣ်ထီအဖုလၢဟီၣ်ခိၣ်ချၢလၢနတၢ်အုၣ်က့ၤခီၣ်က့ၤအဃိလဲၣ်.",
  "28": "မၤသးဒ်လၢၢ်ပူၤ, ဒီးမၤသံတၢ်ဆူလၢၢ်အခိၣ်, ဒီးဆူလၢၢ်အခိၣ်ပူၤလီၤ.",
  "29": "မၤသးဒ်န့ၣ်ဒီး, ဃ့ကညးတၢ်လုၢ်တၢ်ဒိၣ်, အသူၣ်ကိၢ်သးဂီၤအိၣ်ဝးတရံးလီၤ.",
  "30": "အဖုတဖၣ်မၤသံအီၤဒီးသွံၣ်လီၤ. ဒီးဖဲပှၤသံပှၤသံအီၤန့ၣ်, အိၣ်ဒီးအီၤလီၤ."
 },
