{
 "book": "1 Chronicles",
 "chapter": 1,
 "lang": "ksw",
 "verses": {
  "1": "စီၤအၤဒၣ်စီၤစၤသးစီၤဧၤနၤ",
  "2": "စီၤကၤနၣ်စီၤမဃၤလၤစီၤယရၤဒၤ",
  "3": "စီၤဧၤနိးစီၤမတူၡၤလၤစီၤလၤမၢ်",
  "4": "ဒီးစီၤနိအၤ, ဒီးစီၤၡံ, ဒီးစီၤဃၣ်, ဒီးစီၤယၤဖၤ,",
  "5": "ဒီးစီၤယၤဖၤအဖိခွါမ့ၢ်စီၤဃၤမ့ၤ, ဒီးစီၤမဃၤ, ဒီးစီၤမဒၤ, ဒီးစီၤယၤဝၣ်, ဒီးစီၤတူးဘံၣ်, ဒီးစီၤမ့ၡး, ဒီးစီၤတၤရၤလီၤ.",
  "6": "ဒီးစီၤဃူမၢ်စီၤစီၤအၤရှ့ကနး, ဒီးစီၤဒံးဖၤ, ဒီးစီၤတဃၣ်မါလီၤ.",
  "7": "ဒီးစီၤယၤဝၣ်စီၤစီၤအၤလၤစၤ, ဒီးစီၤတၤရၡၤ, ဒီးစီၤကံးတၤ, ဒီးစီၤရၤဒၣ်ယၤလီၤ.",
  "8": "ဒီးစီၤဃၣ်အဖိခွါမ့ၢ်စီၤဃူၡၤ, ဒီးစီၤအံၣ်စရ့လး, ဒီးစီၤဖူး, ဒီးစီၤကၤနၣ်လီၤ.",
  "9": "ဒီးစီၤဃူၡးစီၤၡဘၤ, ဒီးစီၤဃဝီလၤ, ဒီးစီၤၡဘၤတၤ, ဒီးစီၤရၤမါ, ဒီးစီၤရၤဘၤတၤလီၤ. ဒီးစီၤရၤမါစီၤၡဘၤ, ဒီးစီၤဒၤဒၣ်လီၤ.",
  "10": "ဒီးစီၤကူၡးဖှံစီၤနးမၤရၤ, ဒီးစီၤနးမၤရၤမ့ၢ်ပှၤလုၢ်တၢ်အဒိၣ်လၢဟီၣ်ခိၣ်ချၢလီၤ.",
  "11": "ဒီးစီၤအံၣ်စရ့လးဖှံယၤ, ဒီးစီၤအၤနးယၤ, ဒီးစီၤလဃၤဘၤ, ဒီးစီၤနးဖတၤယၤ,",
  "12": "ဒီးစီၤပထရူၡံ, ဒီးစီၤကၤစလၤဃၣ်, (ပှၤဖၤရိၤဖိဟဲက့ၤဆူအီၤ, ) ဒီးစီၤကၤဖၤတံၣ်,",
  "13": "ဒီးစီၤကၤနၣ်ဖှံစီၤၡၤဒၣ်, ဒီးစီၤဃၤသးလီၤ.",
  "14": "ဒီးစီၤအၤမ့ၤၡးဖှံပှၤယဘၤဖိ, ဒီးပှၤဧၤမ့ၤဖိ, ဒီးပှၤကၤရကၤဖိလီၤ.",
  "15": "ပှၤဃံဖိ, ပှၤအၤရးဖိ, ပှၤၡံဖိ,",
  "16": "ပှၤဧၤရဝးဖိ, ပှၤစမၤရးဖိ, ပှၤဃမါတးဖိ,",
  "17": "ဒီးစီၤရှံးစီၤစီၤအၤလၣ်, ဒီးစီၤအၤရှူၤ, ဒီးစီၤအၤရၡး, ဒီးစီၤလူး, ဒီးစီၤအၤရၤ, ဒီးစီၤဧူးၤစၤ, ဒီးစီၤဃူၤလၤ, ဒီးစီၤကၤတၤ, ဒီးစီၤမ့ၡးလီၤ.",
  "18": "ဒီးစီၤအၤရဖၤၡးဖှံစီၤၡၤလၤ, ဒီးစီၤၡၤလၤဖှံစီၤဧၤဘၤ,",
  "19": "ဒီးစီၤဧ့ဘၤမ့ၢ်ဖိခွါခံဂၤလီၤ. စီၤဖၤရၤမ့ၢ်စီၤဧ့ဘၤအပၢ်လီၤ. ဘၣ်ဆၣ်ဒီးလၢစီၤဧ့ဘၤအနံၣ်န့ၣ်ဟီၣ်ခိၣ်လီၤဃၢၤလီၤ. ဒီးစီၤဧ့ဘၤအပၢ်မ့ၢ်စီၤယၤကၤတၣ်လီၤ.",
  "20": "ဒီးစီၤယးကၤတၣ်မ့ၢ်စီၤအၤမဒး, ဒီးစီၤၡၤလဖၤ, ဒီးစီၤဃၤစၤမဝၤ, ဒီးစီၤယရၤလီၤ.",
  "21": "ဒီးစီၤဃဒၤရၤဖှံယၤ, ဒီးစီၤဧူးစၤ, ဒီးစီၤဒကၤလၤလီၤ.",
  "22": "ဒီးစီၤဧ့ဘၤ, ဒီးစီၤအဘံမဧၤ, ဒီးစီၤၡဘၤ,",
  "23": "ဒီးစီၤဧ့ဖၤ, ဒီးစီၤဃဝီလၤ, ဒီးစီၤယၤဘၤလီၤ. ပှၤအံၤခဲလၢာ်မ့ၢ်စီၤယးကၤတၣ်စီၤမုၣ်လီၤ.",
  "24": "ဒီးစီၤၡံ, ဒီးစီၤအၤရဖၡး, ဒီးစီၤၡၤလၤ,",
  "25": "ဒီးစီၤဧၤဘၤ, ဒီးစီၤပၤလၤ, ဒီးစီၤရၤဧၤ,",
  "26": "ဒီးစီၤစရူး, ဒီးစီၤနၤဃၣ်, ဒီးစီၤတၤရၤ,",
  "27": "စီၤအံၣ်စရ့လး, စီၤအံၣ်စရ့လးလီၤ.",
  "28": "ဒီးစီၤအၤဟရိၣ်အဖိခွါမ့ၢ်စီၤအီစၤဃၣ်, ဒီးစီၤယံးစမံၣ်လီၤ.",
  "29": "ဒီးစီၤအၤစၤမံၣ်အပၢ်တဖၣ်မ့ၢ်အအံၤ, ဒီးစီၤအၤစၤမံၣ်စီၤနဘၤယါၤ, ဒီးစီၤကဒၤ, ဒီးစီၤဧးဒဘံၣ်, ဒီးစီၤမံးၡမါလီၤ.",
  "30": "ဒီးစီၤဒူမါ, ဒီးစီၤမၤစၤ, ဒီးစီၤဃၤဒရၤ, ဒီးစီၤတၤမၤ,",
  "31": "ဒီးစီၤယတူး, ဒီးစီၤနဖၤ, စီၤကဒၤမါလီၤ. ပှၤအံၤမ့ၢ်စီၤအၤစၤမံၣ်အဖိခွါလီၤ.",
  "32": "ဒီးစီၤအံၣ်စရ့လးအမါဖိစီၤကတူရၤအဖိခွါမ့ၢ်စီၤၡၤမၣ်, ဒီးစီၤယၤကၡၣ်, ဒီးစီၤမဒၣ်, ဒီးစီၤမဒၤယၣ်, ဒီးစီၤဧ့ၡဘၤ, ဒီးစီၤရှူအၤလီၤ. ဒီးစီၤယၤကၡၣ်စီၤၡၤဘၤ, ဒီးစီၤဒၤဒၣ်လီၤ.",
  "33": "ဒီးစီၤမံးဒယၣ်အဖိခွါမ့ၢ်စီၤဧ့ဖၤ, ဒီးစီၤဧ့ဖီၣ်, စီၤဃနါၤ, စီၤအဘံဒၤ, ဒီးစီၤအၤလဒၤလီၤ. ပှၤအံၤခဲလၢာ်မ့ၢ်စီၤကတၤရၤစီၤမုၣ်လီၤ.",
  "34": "ဒီးစီၤအၤဟရိၣ်ဖှံစီၤအီစၤဃၣ်လီၤ. ဒီးစီၤအီစၤဃၣ်အဖိခွါမ့ၢ်စီၤဧ့ၡံ, ဒီးစီၤအံၣ်စရ့လးလီၤ.",
  "35": "ဒီးစီၤဧ့ၡါၤအဖိခွါမ့ၢ်စီၤအၤလဖၤ, ဒီးစီၤရဃၤဧံၣ်, ဒီးစီၤယူရှံး, ဒီးစီၤယၤလၤ, ဒီးစီၤကၤရၤလီၤ.",
  "36": "ဒီးစီၤအၤလဖၤစီၤစီၤတၤမၣ်, ဒီးစီၤအၤမၣ်, ဒီးစီၤစဖၤ, ဒီးစီၤကၤတၣ်, ဒီးစီၤကၤနး, ဒီးစီၤတၤမၣ်, ဒီးစီၤအၤမံၣ်လီၤ.",
  "37": "ဒီးစီၤရဃၤဧံၣ်စီၤစီၤနဃၤ, ဒီးစီၤစၤရၤ, ဒီးစီၤၡၤမါ, ဒီးစီၤမံးစၤ,",
  "38": "ဒီးစီၤၡၤရံစီၤစီၤလၤတၣ်, ဒီးစီၤၡၤဘဧၣ်, ဒီးစီၤၡံးဘဧၣ်, ဒီးစီၤဧၤနါ, ဒီးစီၤဒၤၡၣ်, ဒီးစီၤဧ့ၡၣ်, ဒီးစီၤဒၤၡၣ်,",
  "39": "ဒီးစီၤလၤတၣ်အဖိခွါမ့ၢ်စီၤဃၤရၤ, ဒီးစီၤဃၤမၣ်, ဒီးစီၤလၤတၣ်အမါမ့ၢ်စီၤတၤမၣ်လီၤ.",
  "40": "ဒီးစီၤရှူဘံၣ်စီၤစီၤအၤလၣ်, ဒီးစီၤမနါကၤ, ဒီးစီၤဧ့ဘံၣ်, ဒီးစီၤၡဖၤ, ဒီးစီၤဧၤနၣ်လီၤ. ဒီးစီၤၡံးဘံၣ်စီၤအၤယါ, ဒီးစီၤအၤနါလီၤ.",
  "41": "ဒီးစီၤအၤနါအဖိခွါမ့ၢ်စီၤဒၤစၤၣ်, ဒီးစီၤဒၤစၤၣ်အဖိခွါမ့ၢ်စီၤဃၤမၣ်, ဒီးစီၤဧ့ၡဘၣ်, ဒီးစီၤဧၤတၤရၣ်, ဒီးစီၤကၤရၣ်လီၤ.",
  "42": "ဒီးစီၤဧ့ၡၢ်အဖိခွါမ့ၢ်စီၤဘၤလဟၣ်, ဒီးစီၤၡၤဧၣ်, ဒီးစီၤယၤကၣ်လီၤ. ဒီးစီၤဒၤၡၣ်စီၤဧူးစၤ, ဒီးစီၤအၤရၣ်လီၤ.",
  "43": "ဒီးစီၤပၤတဖၣ်လၢအကဲစီၤပၤလၢကီၢ်ဧၤဒံၣ်အပူၤလၢစီၤပၤတဂၤကဲစီၤပၤလၢပှၤအံၣ်စရ့လးဖိအဂီၢ်န့ၣ်မ့ၢ်အအံၤ, စီၤဘဧၣ်စီၤဘၤလၤ, ဒီးစီၤဒၤနဃဘၤမ့ၢ်အကီၢ်အပၢ်လီၤ.",
  "44": "ဒီးစီၤဘၤလၤသံဝဲ, ဒီးစီၤစၤရၤစီၤယၤဘၤလၢဘၤစရၤန့ၣ်ကဲစီၤပၤလၢအပူၤလီၤ.",
  "45": "ဒီးစီၤယၤဘၤသံဝဲ, ဒီးစီၤဃူၡၣ်လၢပှၤတၤမၣ်ဖိအကီၢ်န့ၣ်ကဲစီၤပၤလၢပူၤလီၤ.",
  "46": "ဒီးစီၤဃူၡၣ်သံဝဲ, ဒီးစီၤဘဒးစီၤဃၤဒး, ပှၤမၤသံပှၤမံးဒယၣ်ဖိလၢမုၢ်ဘံၣ်အကီၢ်ပူၤန့ၣ်ကဲစီၤပၤလၢအပူၤ, ဒီးဟီၣ်ခိၣ်အကီၢ်မ့ၢ်ဧၤဝၤလီၤ.",
  "47": "ဒီးစီၤဃဒၤသံဝဲ, ဒီးစီၤၡၤမလၤလၢမၤစရကၤန့ၣ်ကဲစီၤပၤလၢအပူၤလီၤ.",
  "48": "ဒီးစီၤၡမၤလၤသံဝဲ, ဒီးစီၤစီလူးလၢထံခိၣ်န့ၣ်ကဲစီၤပၤလၢအပူၤလီၤ.",
  "49": "ဒီးစီၤစီလူးသံဝဲ, ဒီးစီၤအၤဃဘၤစီၤဘဧၤဃၣ်ကဲစီၤပၤလၢပူၤလီၤ.",
  "50": "ဒီးစီၤဘဧၤဃၤနၣ်သံဝဲ, ဒီးစီၤဃၤဒၤကဲစီၤပၤလၢအပူၤ, ဒီးစီၤပၤဧၤမ့ၢ်အကီၢ်အပၢ်, ဒီးစီၤမၢ်သတၤဘံၣ်မ့ၢ်အမါ, ဒီးစီၤမၤထရ့ၤးစီၤမၤစၤစီၤဖိခွါလီၤ.",
  "51": "ဒီးစီၤဃၤဒးသံဝဲ, ဒီးစီၤအၤဒၤအစီၤပၤတဖၣ်မ့ၢ်အအံၤ, ဒီးစီၤတၤမၣ်အစီၤပၤ, ဒီးစီၤအၤလဝၤအစီၤပၤ, ဒီးစီၤယၤသၤအစီၤပၤ,",
  "52": "ခိၣ်အၤဟလၤမါ, ခိၣ်ဧၤလၤ, ခိၣ်ဖၤနၣ်,",
  "53": "ခိၣ်ကၤနး, ခိၣ်တၤမၣ်, ခိၣ်မံးစၤ,",
  "54": "စီၤပၤမကဒံၣ်, စီၤပၤဧၤရၤလီၤ. ပှၤအံၤမ့ၢ်အၤဒံၣ်အစီၤပၤတဖၣ်လီၤ."
 },
 "notes": "",
