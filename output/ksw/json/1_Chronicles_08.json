{
 "book": "1 Chronicles",
 "chapter": 8,
 "lang": "ksw",
 "verses": {
  "1": "ဒီးစီၤဘံၣ်ယၤမ့လးဖှံစီၤဘၤလၤ, ဒီးစီၤအၤရှ့ဘံၣ်, ဒီးစီၤဧၤဃရၤ,",
  "2": "စီၤနိအၤလွံၢ်ဂၤ, စီၤရၤဖၤလွံၢ်ဂၤ,",
  "3": "ဒီးစီၤဘၤလၤစီၤစီၤအၤဒၤ, ဒီးစီၤကၤရၤ, ဒီးစီၤအဘံဟူးလီၤ.",
  "4": "ဒီးစီၤအဘံရှူ, ဒီးစီၤနဧၤမၣ်, ဒီးစီၤဧၤဃံ,",
  "5": "ဒီးစီၤကၤရၤ, ဒီးစီၤရှူဖၤ, ဒီးစီၤဃူရၣ်,",
  "6": "ပှၤအံၤမ့ၢ်စီၤဧၤဟူးအဖိခွါလီၤ. စီၤဧၤဃူးမ့ၢ်ပှၤကံးဘဧၣ်ဖိအပၢ်တဖၣ်အခိၣ်လီၤ. ဒီးဟဲစိာ်အီၤဆူမၤနဟးလီၤ.",
  "7": "ဒီးစီၤနဧၤမၣ်, ဒီးစီၤအၤဃယၤ, ဒီးစီၤကၤရၤ, ဒီးစီၤကၤရၤဟဲစိာ်အီၤ, ဒီးစီၤဧ့ၡါ, ဒီးစီၤအၤဃယၤလီၤ.",
  "8": "ဒီးစီၤၡကၤရယၤဖှံစီၤဃူၡံ, ဒီးစီၤဘဧၤရၤလၢကီၢ်မံၣ်အပူၤ, လၢအမၤသံအီၤဒီး,",
  "9": "ဒီးဆံးနံၣ်ဒီးမါ, ဒီးဖှံစီၤယၤဘၤ, ဒီးစီၤစဘၤဧၢ,  စီၤမ့ၡၣ်, စီၤမၤလကၣ်လီၤ.",
  "10": "ဒီးစီၤယူၤစၤ, ဒီးစီၤၡကၤ, ဒီးစီၤမ့ၤရၣ်လီၤ. ပှၤအံၤမ့ၢ်အပၢ်တဖၣ်အခိၣ်တဖၣ်လီၤ.",
  "11": "ဒီးစီၤဃူၡံဖှံစီၤအဘံတူး, ဒီးစီၤအၤလဖၤလီၤ.",
  "12": "ဒီးစီၤအၤလပဧၤစီၤစီၤဧ့ဘၤ, ဒီးစီၤမၤရှၤ, ဒီးစီၤၡမၤလီၤ. ဒီးစီၤဧ့ဘၤမၤထီၣ်အၤနိ, ဒီးအကီၢ်တဖၣ်လီၤ.",
  "13": "ဒီးစီၤဘၤရၤ, ဒီးစီၤၡမါလီၤ. ပှၤအံၤမ့ၢ်အၤယါလၣ်ဖိအပၢ်တဖၣ်အခိၣ်တဖၣ်, ဒီးဒုးဟဲထီၣ်ပှၤကးဖိလီၤ.",
  "14": "ဒီးစီၤၡၤၡး, ဒီးစီၤဧၤရိမၤ,",
  "15": "ဒီးစီၤစဘၤဒယၤ, ဒီးစီၤဧဒၤ, ဒီးစီၤဧဒၤ,",
  "16": "ဒီးစီၤယၤကိာ်, ဒီးစီၤဧၤစဖၤ, စီၤယဟိၤယါ, စီၤဘရၤရယၤအပၢ်တဖၣ်,",
  "17": "ဒီးစီၤစဘၤဒယၤ, ဒီးစီၤမရှူလၤ, ဒီးစီၤဃၤစကၤ, ဒီးစီၤဃဘၤ,",
  "18": "ဒီးစီၤယံးၡမရံ, ဒီးစီၤစလၤယါ, စီၤယၤဘၤ, စီၤဧၤလဖၤအဖိခွါတဖၣ်,",
  "19": "ဒီးစီၤယၤကိာ်, ဒီးစီၤၡကၤရီ, ဒီးစီၤၡးဘဒၤ,",
  "20": "ဒီးစီၤအၤလၤနါ, ဒီးစီၤတၤလၤ, ဒီးစီၤအၤလၤဧၤ,",
  "21": "ဒီးစီၤဧဒၤယၤ, ဒီးစီၤဘၤရယၤ, ဒီးစီၤၡံရၤ, စီၤၡံယၤအဖိခွါတဖၣ်,",
  "22": "ဒီးစီၤယံးၡၣ်, ဒီးစီၤဧၤဘၤ, ဒီးစီၤအၤလယၤ,",
  "23": "ဒီးစီၤဧၤဘဒၣ်, ဒီးစီၤၡကၤရီ, ဒီးစီၤကၤနါ,",
  "24": "ဒီးစီၤဃၤနယၤ, ဒီးစီၤဧၤလၣ်, ဒီးစီၤဧၤနတၤယၤ,",
  "25": "ဒီးစီၤယံးဒယၤ, ဒီးစီၤဖနူဧၤ, စီၤၡၤၡးစီၤၡၤၡး,",
  "26": "ဒီးစီၤၡံၡဧၤ, ဒီးစီၤၡၤဃရိယၤ, ဒီးစီၤဧတၤလယၤ,",
  "27": "ဒီးစီၤယရၤၡယၤ, ဒီးစီၤအံၣ်စရ့လး, စီၤၡကၤရိၤ, စီၤယရ့ၤဃၣ်အဖိခွါတဖၣ်,",
  "28": "ပှၤအံၤမ့ၢ်အပၢ်တဖၣ်အခိၣ်တဖၣ်, ဒ်အကလုာ်တဖၣ်အသိးလီၤ. ပှၤအံၤအိၣ်ဖှိၣ်ရိဖှိၣ်လၢယရူၤၡယၤအပူၤလီၤ.",
  "29": "ဒီးစီၤအဘံယၤအိၣ်ဖှိၣ်ရိဖှိၣ်လၢဃံးဘဧၣ်အပူၤ, ဒီးအမါတဂၤန့ၣ်မ့ၢ်စီၤမါကၤလီၤ.",
  "30": "ဒီးစီၤအၤဘဒၣ်, ဒီးစီၤစူၤ, ဒီးစီၤကၤစၤ, ဒီးစီၤဘဧၣ်, ဒီးစီၤနဒၤ,",
  "31": "ဒီးစီၤဃဒၤ, ဒီးစီၤစကၤရၤ,",
  "32": "ဒီးစီၤမံးကလးဖှံစီၤၡၤမါလီၤ. ဒီးအဝဲသ့ၣ်တဖၣ်အိၣ်ဖှိၣ်ရိဖှိၣ်ဒီးအပၢ်တဖၣ်လၢယရူၤၡၣ်အပူၤ, လၢယရူၤၡၣ်ပူၤလီၤ.",
  "33": "ဒီးစီၤနးဖှံစီၤကၤစၤ, ဒီးစီၤကၤစၤဖှံစီၤစီလူး, ဒီးစီၤစီလူးဖှံစီၤယၤနၤ, ဒီးစီၤမၤလကၤရှူၤ, ဒီးစီၤအဘံနဒး, ဒီးစီၤဧ့ၡဘဧၤလီၤ.",
  "34": "ဒီးစီၤယၤနါၤအဖိခွါမ့ၢ်စီၤမၤရဘဧၤ, ဒီးစီၤမၤရဘဧၤဖှံစီၤယၤကါလီၤ.",
  "35": "ဒီးစီၤမံးကၤစီၤစီၤပံးတၤ, ဒီးစီၤမၤလၤ, ဒီးစီၤတၤရယၤ, ဒီးစီၤအၤဃၤလီၤ.",
  "36": "ဒီးစီၤအၤဃးဖှံစီၤယဟိၤယဒၤ, ဒီးစီၤယဟိၤယဒၤဖှံစီၤအၤလမၢ်, ဒီးစီၤအၤစမးဝၤ, ဒီးစီၤၡၤမရီ, ဒီးစီၤၡၤမရီဖှံစီၤယၤစၤလီၤ.",
  "37": "ဒီးစီၤမၤစၤဖှံယၤ, ဒီးစီၤရၤဖၤဖှံယၤ, ဒီးစီၤအၤလဧၤဖှံယၤ, ဒီးစီၤဧ့ၡဲဖှံယၤလီၤ.",
  "38": "ဒီးစီၤဧ့ၡဲမ့ၢ်စီၤမုၣ်ဃံတဂၤ, ဒီးစီၤဧ့ၡဲအပၢ်စီၤဧစၤရကၣ်, ဒီးစီၤအၤစၤမံၣ်, ဒီးစီၤစၤရယၤ, ဒီးစီၤဧဘၤဒယၤ, ဒီးစီၤကၤနါလီၤ. စီၤဧ့ၡဲအပၢ်တဖၣ်ခဲလၢာ်လီၤ.",
  "39": "ဒီးစီၤဧ့ၡဲအဖိခွါမ့ၢ်စီၤအံၣ်လၤ, ဒီးစီၤယူၤရှံး, ဒီးစီၤဧၤလဖၤလၤ,",
  "40": "ဒီးစီၤသြၤလၣ်စီၤစီၤအၤဃး, စီၤဧူးလၤစီၤဧူလၤ, ဒီးစီၤဧူးလူးစီၤဧူးကလၤ, စီၤယံးၡံယၤ, စီၤဘၤမိၣ်ယၤ,"
 },
 "notes": "",
