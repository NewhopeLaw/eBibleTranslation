{
 "book": "Matthew",
 "chapter": 1,
 "lang": "ksw",
 "verses": {
  "1": "စီၤဒၤဝံးအဖိခွါ, စီၤအၤဘ့ၤသဧၢ, စီၤယၤကိာ်,",
  "2": "ဒီးစီၤအၤဟရိၣ်ဖှံစီၤအီစၤဃး, ဒီးစီၤအီစၤဃးဖှံစီၤယၤကိာ်, ဒီးစီၤယၤကိာ်ဖှံစီၤယူဒၤ, ဒီးစီၤယၤကိၢ်,",
  "3": "ဒီးစီၤယူဒၤဖှံစီၤဖၤရၤ, ဒီးစီၤစၤရၤလၢစီၤတၤမၤ, ဒီးစီၤဖၤရၤဖှံစီၤဃၤစၤရၣ်, ဒီးစီၤဃၤစၤရၣ်ဖှံစီၤအၤရၣ်,",
  "4": "ဒီးစီၤအၤရၤဖှံစီၤအၤမၤနဒၤ, ဒီးစီၤအၤမၤနဒၤဖှံစီၤနးၡၣ်, ဒီးစီၤနးၡၣ်ဖှံစီၤၡၤလၣ်,",
  "5": "ဒီးစီၤၡၤမၣ်ဖှံစီၤဘၤဧးလၢစီၤရၤဃး, ဒီးစီၤဘၤဧးဖှံစီၤအၤဘၤလၢစီၤရူး, ဒီးစီၤအၤဘၤဖှံစီၤယံးၡဲ,",
  "6": "ဒီးစီၤယံးၡံယၤဖှံစီၤဒၤရိၤ, ဒီးစီၤဒၤရိၤဖှံစီၤစီလူးလၢစီၤအူးရိယၤအမါ,",
  "7": "ဒီးစီၤစီလူးဖှံစီၤရဟၤမါ, ဒီးစီၤရဟၤမါဖှံစီၤအဘံယၤ, ဒီးစီၤအဘံယၤဖှံစီၤအၤစၤ,",
  "8": "ဒီးစီၤအၤစၤဖှံစီၤယဟိၤရှ့ဖၤ, ဒီးစီၤယဟိၤရှ့ဖၤဖှံစီၤယဟိၤရၣ်, ဒီးစီၤယဟိၤရၣ်ဖှံစီၤဧူးစယၤ,",
  "9": "ဒီးစီၤအၤစယၤဖှံစီၤယဟိၤတၣ်, ဒီးစီၤယဟိၤတၣ်ဖှံစီၤအၤဃး, ဒီးစီၤအၤဃးဖှံစီၤဃံးစကံယၤ,",
  "10": "ဒီးစီၤဃံးစကံယၤဖှံစီၤမနါၡဲ, ဒီးစီၤမနါၡဲဖှံစီၤအၤမၣ်, ဒီးစီၤအၤမၣ်ဖှံစီၤယၤရှံး,",
  "11": "ဒီးစီၤယဟိၤယါၡိယၤဖှံစီၤယဟိယၤကၣ်, ဒီးအပၢ်တဖၣ်လၢဘံၣ်စရ့လးအပူၤလၢပှၤကိၢ်တၢ်ဂီၤအိၣ်ဘှံးန့ၣ်လီၤ.",
  "12": "ဒီးစီၤယဟိၤယါကၣ်ဖှံစီၤၡၤလတၤ, ဒီးစီၤၡၤလတၤဖှံစီၤစရူဘၤဘၤ,",
  "13": "ဒီးစီၤစရူးဘဘၤဖှံစီၤအဘံဧး, ဒီးစီၤအဘံဧးဖှံစီၤယလိကယၤ, ဒီးစီၤယလီကယၤဖှံစီၤဧ့ၡၣ်,",
  "14": "ဒီးစီၤဧ့ၡၣ်ဖှံစီၤၡၤဒး, ဒီးစီၤၡၤဒးဖှံစီၤအၤဃံ, ဒီးစီၤအၤဃံဖှံစီၤအၤလယၤ,",
  "15": "ဒီးစီၤအလံယူးဖှံစီၤအၤလၤဧၤ, ဒီးစီၤအၤလၤဧၤဖှံစီၤမၤတၤ, ဒီးစီၤမၤတၤဖှံစီၤယၤကိာ်,",
  "16": "ဒီးစီၤယၤကိာ်ဖှံစီၤယၤစိာ်, စီၤၡၤမါအဖု, ဒီးစီၤယံးၡံၡါဖှံအီၤ, ဒီးစံးဝဲဒၣ်, ယွၤလီၤ.",
  "17": "မၤသးဒ်န့ၣ်ဒီး, ပှၤတဆံလွံၢ်ဂၤလၢစီၤအၤဘရိၤန့ၣ်ဆူစီၤဒၤဝီလီၤ. ဒီးလၢစီၤဒၤဝီန့ၣ်ဆူပှၤဟဲစၢၢ်ကလိဆူဘံၣ်စရ့လးန့ၣ်, မ့ၢ်တဆံလွံၢ်ဂၤလီၤ. ဒီးလၢပှၤဟဲစၢၢ်ကလိဆူဘံၣ်စရ့လးန့ၣ်ဆူယွၤန့ၣ်, မ့ၢ်တဆံလွံၢ်ဂၤလီၤ.",
  "18": "ဒီးစီၤယၤကူၤၡးအတၢ်ဟဲဝဲန့ၣ်, မၤသးဒ်အံၤအသိးလီၤ. ဒီးတုၤအပၢ်စီၤမ့ၤရိၤမၤဃူကွံာ်အီၤဒီးစီၤယၤကိာ်ဒီး, တမ့ၢ်ဘၣ်ဒီး, မၤဃူက့ၤအီၤဘၣ်. ဒီးကွၢ်ကွၢ်, ပာ်ခူသးလၢသးစီဆှံလီၤ.",
  "19": "ဒီးအမါစီၤယၤစိာ်မ့ၢ်ပှၤတီပှၤလိၤ, ဒီးတပာ်ဘၣ်အလိၤဘၣ်, ဒီးစံးဝဲဒၣ်, မ်အပာ်ကွံာ်အီၤသပှၢ်တၢၢ်လီၤ.",
  "20": "ဒီးတုၤအသ့ၣ်ညါတၢ်အံၤဒီး, မၤသးဒ်န့ၣ်ဒီး, ယွၤအကလူးတဂၤဟဲဝဲဆူအလိၤလၢနွံနံၤ, ဒီးစံးဝဲဒၣ်, စီၤဒၤဝံးစီၤယၤစိာ်ဧၢ, ဃ့ကညးဘၣ်နမါစီၤမ့ၤရိၤတက့ၢ်. ဘၣ်ဆၣ်ဒီးပှၤအိၣ်ဖှိၣ်လၢအပူၤန့ၣ်, ကဲထီၣ်လၢသးစီဆှံလီၤ.",
  "21": "ဒီးကဖှံပှၤဖိခွါ, ဒီးနဘၣ်စံးဝဲဒၣ်, စီၤယၤကိာ်လီၤ. မ့ၢ်အပာ်လီၤဃၣ်အစီၤပၤလၢအသးကမၣ်လီၤ.",
  "22": "မၤသးဒ်န့ၣ်ဒီး, တၢ်အံၤခဲလၢာ်ကဲထီၣ်လၢယွၤစံးဝဲဒၣ်လၢဝံ, ဒီးစံးဝဲဒၣ်,",
  "23": "မၤသးဒ်န့ၣ်ဒီး, မၤသးဒ်န့ၣ်ဒီး, ပှၤဖိခွါတဂၤန့ၣ်, ကထိၣ်ဆံး, ဒီးကထိၣ်ဖိခွါ, ဒီးပှၤကစံးဝဲဒၣ်, အၤမါနံၣ်လီၤ. မ့ၢ်တၢ်စံးဝဲဒၣ်, ယွၤမ့ၢ်ဒီးပှၤလီၤ.",
  "24": "ဒီးတုၤစီၤယၤစူၤၡၢ်ထးခိၣ်ဒီး, မၤဒ်ယွၤအကလူးမၤလိာ်အီၤအသိးန့ၣ်, ဒီးဟဲစိာ်အမါလီၤ.",
  "25": "ဒီးတုၤအဖှံယၤတဂၤဒီး, တသ့ၣ်ညါဘၣ်အီၤဘၣ်. ဒီးစံးဝဲဒၣ်, စီၤယၤစိာ်လီၤ."
 },
