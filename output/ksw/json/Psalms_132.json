{
 "book": "Psalms",
 "chapter": 132,
 "lang": "ksw",
 "verses": {
  "1": "ယွၤဧၢ, သ့ၣ်ညါစီၤဒၤဝံးအလုၢ်အဒိၣ်ခဲလၢာ်တက့ၢ်.",
  "2": "ဆိၣ်တၢ်ဆူယွၤအပူၤ, ဆိၣ်တၢ်ဆူစီၤယၤကိာ်အကစၢ်အပူၤလီၤ.",
  "3": "ယမ့ၢ်ဟဲက့ၤဆူယဒဲပူၤဒီး, ယဟဲက့ၤဆူယလီၢ်ခံပူၤဒီး,",
  "4": "ယမ့ၢ်ဒုးနးထီၣ်ယသး, ဒီးယသးကိၢ်ယသးဂီၤ, ဒီးယသးကိၢ်ယသးဂီၤဒီး,",
  "5": "ယသ့ၣ်ညါယွၤလၢအပူၤ, ဒီးစီၤယၤကိာ်အကစၢ်အဟံၣ်လီၤ.",
  "6": "ပနၢၤအီၤလၢဧ့ဖရၤတၤအပူၤ, ပထံၣ်ဘၣ်အီၤလၢထံပူၤအကီၢ်ပူၤလီၤ.",
  "7": "မ်ပဟဲဆူအဟံၣ်ပူၤတက့ၢ်. မ်ပမၤကမၣ်တၢ်လၢအလီၢ်လၢအလိၤတက့ၢ်.",
  "8": "ယွၤဧၢ, လဲၤလီၤဆူနအိၣ်ဘှံးပူၤ, နၤ, ဒီးယနတၢ်အုၣ်က့ၤခီၣ်က့ၤထးခိၣ်တက့ၢ်.",
  "9": "မ်နပှၤအုၣ်က့ၤခီၣ်က့ၤတၢ်န့ၣ်ကိၢ်တၢ်ဂီၤလၢတၢ်တီတၢ်လိၤ, ဒီးမ်နပှၤအုၣ်က့ၤခီၣ်က့ၤတၢ်တဖၣ်ကစံးဝဲဒၣ်, မ်ပသူၣ်ဖှံသးညီလီၤ.",
  "10": "နပှၤစီၤဒၤဝံးအဃိဒီး, ဒုးဟဲစိာ်နပှၤဖှံအီၤအလိၤဘၣ်.",
  "11": "ယွၤဆိၣ်ဝဲလၢစီၤဒၤဝံးအဂီၢ်လၢတၢ်တီတၢ်လိၤ, ဒီးယကပာ်နၤလၢနခိၣ်သလုးအပူၤလၢနခိၣ်သလုးပူၤလီၤ.",
  "12": "နဖိခွါမ့ၢ်ထိၣ်ပာ်ယတၢ်အၢၣ်လီၤအီလီၤ, ဒီးယတၢ်အုၣ်က့ၤခီၣ်က့ၤလၢယကသ့ၣ်ညါအီၤဒီး, အဖိခွါန့ၣ်ကအိၣ်ဖှိၣ်ရိဖှိၣ်လၢနခိၣ်သလုးပူၤလီၤထူလီၤယိာ်လီၤ.",
  "13": "ဘၣ်ဆၣ်ဒီးယွၤပာ်လီၤစၤယၣ်, အဲၣ်အီၤဒ်သိးအကအိၣ်ဖှိၣ်ရိဖှိၣ်လီၤ.",
  "14": "တၢ်အံၤမ့ၢ်ယဟံၣ်လၢယအိၣ်ဘှံးလီၤထူလီၤယိာ်လီၤ. ယကအိၣ်ဘှံးဖဲအံၤလီၤ. ယွၤစံးဝဲဒၣ်, ယဘၣ်အီၤလီၤ.",
  "15": "ယကအုၣ်က့ၤခီၣ်က့ၤအီၤ, ယကပာ်ခူသူၣ်အီၤ, ယကပာ်ခူသးလၢကိၢ်တၢ်ဂီၤလီၤ.",
  "16": "ဒီးယကဖိးထီၣ်အပှၤလုၢ်တၢ်အဒိၣ်လၢတၢ်အုၣ်က့ၤခီၣ်က့ၤ, ဒီးအပှၤအုၣ်က့ၤခီၣ်က့ၤတၢ်တဖၣ်ကကိၢ်တၢ်ဂီၤလီၤ.",
  "17": "ဒီးယကဒုးဟဲထီၣ်စီၤဒၤဝံးအဃၣ်လၢအပူၤ, ယကပာ်လီၤမ့ၣ်အူလၢယပှၤဖိၣ်ထီၣ်အီၤအဂီၢ်လီၤ.",
  "18": "ယကပာ်အဒုၣ်ဒွဲၣ်လၢတၢ်ဒုၣ်ဒွဲၣ်လီၤ. ဒီးယကပာ်ယတၢ်စီဆှံလၢအပူၤလီၤ."
 },
