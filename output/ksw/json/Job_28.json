{
 "book": "Job",
 "chapter": 28,
 "lang": "ksw",
 "verses": {
  "1": "မၤသးဒ်န့ၣ်ဒီး, ဆီအခိၣ်န့ၣ်မ့ၢ်လၢအံၤ, ဒီးထူအခိၣ်န့ၣ်မ့ၢ်လၢအံၤလီၤ.",
  "2": "ပှၤဟဲစိာ်ထးလၢဟီၣ်ခိၣ်ချၢ, ဒီးကစၢၢ်ကလိလၢလၢၤပူၤလီၤ.",
  "3": "ပာ်အခိၣ်လၢတၢ်ညၣ်အပူၤ, ဒီးလၢဟီၣ်ခိၣ်ချၢအပူၤ, ပာ်တၢ်ညၣ်လၢလၢၢ်, ဒီးလၢၢ်သယိာ်လီၤ.",
  "4": "မၤသးဒ်န့ၣ်ဒီး, ယမၤကိၢ်တၢ်ဂီၤလၢဟီၣ်ခိၣ်ချၢ, လၢပှၤနးကွံာ်အီၤအကီၢ်ပူၤ, လၢပှၤကညီအကျဲပူၤလီၤ. မ်အပာ်ကွံာ်အီၤ, ဒီးမ်အဒုးဟဲထီၣ်အီၤဘၣ်.",
  "5": "ကိၣ်ဟဲလီၤလၢဟီၣ်ခိၣ်ချၢ, ဒီးအိၣ်ဘှံးဝဲဒ်မ့ၣ်အူအသိးလီၤ.",
  "6": "ကျဲလၢလၢၢ်သပၢၤန့ၣ်မ့ၢ်အပူၤ, ဒီးထူအဖုန့ၣ်မ့ၢ်အပူၤလီၤ.",
  "7": "ကျဲလၢသိတသ့ၣ်ညါဘၣ်, ဒီးထိၣ်ဖိတသ့ၣ်ညါဘၣ်.",
  "8": "ဒီးပှၤမၤသံတၢ်တဖၣ်တကွၢ်ဘၣ်အီၤဘၣ်, ဒီးသိတဟဲစိာ်ဘၣ်အီၤဘၣ်.",
  "9": "ပာ်လီၤအစုဆူတၢ်လၤဝၤအပူၤ, ပာ်လီၤကွံာ်ကစၢၢ်ကလိအခိၣ်လီၤ.",
  "10": "ဃၣ်ထီၣ်မ့ၣ်အူလၢထံပူၤ, ဒီးအသးကွၢ်တၢ်လုၢ်ဒိၣ်ဒိၣ်ဒိၣ်ခဲလၢာ်လီၤ.",
  "11": "ပာ်ထီၣ်ထီမ့ၣ်အူလၢထံပူၤ, ဒီးဟဲစိာ်တၢ်ဂီၤလၢထံပူၤလီၤ.",
  "12": "ဘၣ်ဆၣ်ဒီးတၢ်ကူၣ်တၢ်ဆးန့ၣ်ကကဲထီၣ်လၢလဲၣ်. ဒီးတၢ်အုၣ်က့ၤခီၣ်က့ၤအဟံၣ်န့ၣ်မ့ၢ်လၢလဲၣ်.",
  "13": "ပှၤကညီတသ့ၣ်ညါဘၣ်အလုၢ်အဒိၣ်ဘၣ်. ဒီးတထံၣ်ဘၣ်ဘၣ်အီၤလၢပှၤမူတဖၣ်အပူၤဘၣ်.",
  "14": "လၢထံပူၤန့ၣ်စံးဝဲဒၣ်, တမ့ၢ်ဘၣ်ဒီးယၤဘၣ်, ဒီးပီၣ်လဲၣ်န့ၣ်စံးဝဲဒၣ်, တမ့ၢ်ဘၣ်ဒီးယၤဘၣ်.",
  "15": "ခိၣ်သလုးန့ၣ်တချုးပာ်ထီၣ်ထီဘၣ်အီၤဘၣ်, ဒီးကိၢ်တၢ်ဂီၤန့ၣ်တချုးပာ်ထီၣ်ထီဘၣ်အီၤဘၣ်.",
  "16": "အၤဖၤအထူ, ဒီးသိအထူ, ဒီးသိအထူအထူန့ၣ်တမၤလိာ်ဘၣ်အီၤဘၣ်.",
  "17": "ဒီးထူဒီးကစၢၢ်ကလိတဟဲစိာ်ဘၣ်အီၤဘၣ်, ဒီးအဂံၢ်အဘါတလဲၤစူၢ်ဘၣ်အီၤဒ်တၢ်လုၢ်ဒိၣ်ဒိၣ်ဒိၣ်တဖၣ်အသိးဘၣ်.",
  "18": "မၤသးဒ်န့ၣ်ဒီး, တၢ်အုၣ်က့ၤခီၣ်က့ၤအီၤန့ၣ်, မ်အသုတပာ်ဖှိၣ်ဘၣ်အီၤဘၣ်. ဒီးတၢ်ကူၣ်တၢ်ဆးန့ၣ်, တဟဲထီၣ်ဘၣ်လၢအပူၤဘၣ်.",
  "19": "ပှၤကျုးရှံးဖိအခိၣ်သလုးန့ၣ်တဟဲစိာ်ဘၣ်အီၤဘၣ်, ဒီးထူစိာ်န့ၣ်တဟဲစိာ်ဘၣ်အီၤဘၣ်.",
  "20": "ဒီးတၢ်ကူၣ်တၢ်ဆးန့ၣ်ကဟဲလၢလဲၣ်. ဒီးတၢ်ကူၣ်တၢ်ဆးန့ၣ်အိၣ်ဖှိၣ်လၢလဲၣ်.",
  "21": "ဒီးပာ်ခူသးလၢပှၤမူဝဲခဲလၢာ်အခီၣ်ပူၤ, ဒီးပာ်ခူသးလၢသိလၢပျုၤပူၤလီၤ.",
  "22": "တၢ်သံဒီးဟီၣ်ခိၣ်ချၢနၢၤအီၤ, ဒီးနၢၤအကလုာ်လီၤ.",
  "23": "ယွၤဘၣ်သ့ၣ်ညါအကျဲ, ဒီးဘၣ်သ့ၣ်ညါအကီၢ်လီၤ.",
  "24": "မ့ၢ်အကွၢ်တၢ်ဆူဟီၣ်ခိၣ်အပူၤ, ဒီးကွၢ်တၢ်ခဲလၢာ်လၢဟီၣ်ခိၣ်အပူၤလီၤ.",
  "25": "ပာ်ကိၣ်လၢထံ, ဒီးမၢလီၤထံအခိၣ်လီၤ.",
  "26": "တုၤအပာ်တၢ်ကူၣ်တၢ်ဆး, ဒီးကျဲလၢသိအသံအဂီၢ်ဒီး,",
  "27": "ဒီးထံၣ်ဘၣ်တၢ်အုၣ်က့ၤခီၣ်က့ၤ, ဒီးစံးဝဲဒၣ်, ဒီးပာ်ထီၣ်ထီအီၤ, ဒီးသ့ၣ်ညါအီၤလီၤ.",
  "28": "ဒီးစံးဝဲဒၣ်လၢပှၤအဂီၢ်, တၢ်ပျံၤယွၤန့ၣ်မ့ၢ်တၢ်အုၣ်က့ၤခီၣ်က့ၤတၢ်, ဒီးတၢ်ဃၣ်ကွံာ်တၢ်ကမၣ်န့ၣ်မ့ၢ်တၢ်အုၣ်က့ၤခီၣ်က့ၤတၢ်လီၤ."
 },
