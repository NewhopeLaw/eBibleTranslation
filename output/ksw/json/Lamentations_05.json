{
 "book": "Lamentations",
 "chapter": 5,
 "lang": "ksw",
 "verses": {
  "1": "ယွၤဧၢ, မၤသးဒ်န့ၣ်ဒီး, သ့ၣ်ညါပှၤတက့ၢ်. မၤသးဒ်လဲၣ်ဒ်လဲၣ်န့ၣ်ကွၢ်, ဒီးကွၢ်ပတၢ်ပျံၤတၢ်ဖုးတက့ၢ်.",
  "2": "ပတၢ်လုၢ်တၢ်ဒိၣ်န့ၣ်ပာ်ကွံာ်အီၤဆူပှၤအိၣ်ဘှံးတဖၣ်, ပဟံၣ်တဖၣ်ဆူပှၤအိၣ်ဘှံးတဖၣ်အစုပူၤလီၤ.",
  "3": "ပမ့ၢ်ပှၤဖိခွါတဂၤ, ပပၢ်ဘၣ်, ပပၢ်မ့ၢ်ပှၤဖိခွါတဂၤအသိးလီၤ.",
  "4": "ပအီထံလၢစိာ်, ဒီးမ့ၣ်အူလၢစိာ်လီၤ.",
  "5": "ပှၤဟဲစိာ်ယၤကိာ်လၢပစုပူၤလီၤ. ပမၤကမၣ်တၢ်, ဒီးသုတအိၣ်ဘှီၣ်ကလာ်ဘၣ်.",
  "6": "အံၣ်စရ့လးဟ့ၣ်အစု, ဒီးအၤရှံၣ်ဟ့ၣ်ကိၢ်တၢ်ဂီၤလၢပဂီၢ်လီၤ.",
  "7": "ပပၢ်တဖၣ်မၤကမၣ်တၢ်, ဒီးတမ့ၢ်ဘၣ်ဘၣ်, ဒီးပပာ်ပတၢ်ကမၣ်လီၤ.",
  "8": "ကလီကလီတဖၣ်မၤလိာ်ပှၤလီၤ. ဒီးပှၤပာ်ထီၣ်ထီပှၤလၢအစုပူၤတဂၤဘၣ်.",
  "9": "ပမၤသးဒ်ပသးအသိးန့ၣ်, ပကဲထီၣ်ဒ်ပှၤကိၢ်တၢ်ဂီၤလၢဟီၣ်ခိၣ်ချၢအသိးလီၤ.",
  "10": "ပထူလီၤဃၣ်ဒ်ကိၣ်အသိးန့ၣ်, လၢတၢ်လုၢ်တၢ်ဒိၣ်အဃိလီၤဃၣ်လီၤဃၣ်လီၤ.",
  "11": "ပှၤမုၣ်ကမဲလၢစံယၣ်အပူၤ, ပှၤမုၣ်ကမဲလၢယူဒၤအကီၢ်ပူၤန့ၣ်, ပာ်အသးကိာ်လီၤ.",
  "12": "ပှၤခိၣ်တဖၣ်မၤသံအီၤ, ပှၤပှၢ်မုၢ်ကိၢ်အခိၣ်န့ၣ်တမၤဂုၤဘၣ်အီၤဘၣ်.",
  "13": "ပှၤအုၣ်က့ၤခီၣ်က့ၤပှၤန့ၣ်မၤသးကိၢ်တၢ်ဂီၤလီၤ. ဒီးပှၤဖိၣ်ဖိၣ်လီၤဃၣ်ကွံာ်လၢထံပူၤလီၤ.",
  "14": "ပှၤအါဂၤအိၣ်ဘှီၣ်ကလာ်လၢပဲတရီပူၤ, ပှၤဖိခွါတဖၣ်မၤသံတၢ်လီၤ.",
  "15": "ပသးကိၢ်တၢ်ဂီၤန့ၣ်ဟဲက့ၤကဒါက့ၤဆူတၢ်ဒုၣ်ဒွဲၣ်, ဒီးပတၢ်ဟဲစိာ်န့ၣ်ဟဲက့ၤကဒါက့ၤဆူတၢ်ဒုၣ်ဒွဲၣ်လီၤ.",
  "16": "ပခိၣ်အခိၣ်သလုးဟဲလီၤ. ပမၤကမၣ်တၢ်ဒ်လဲၣ်.",
  "17": "တၢ်အံၤအဃိ, ပသးကိၢ်တၢ်ဂီၤ, တၢ်အံၤအဃိ, ပသူၣ်ကိၢ်သးဂီၤလီၤ.",
  "18": "လၢကစၢၢ်စၤယၣ်အပူၤ, လၢမုၢ်မဆါတနံၤအံၤ, ကစၢၢ်ကလိဟဲစိာ်ဝဲလီၤ.",
  "19": "ယွၤဧၢ, နအိၣ်ဖှိၣ်ရိဖှိၣ်လီၤထူလီၤယိာ်လီၤ. နခိၣ်သလုးန့ၣ်အိၣ်ဖှိၣ်ရိဖှိၣ်လီၤထူလီၤယိာ်လၢမုၢ်မဆါတနံၤအံၤဒီးမုၢ်မဆါတနံၤအံၤလီၤ.",
  "20": "နသးပ့ၤနီၣ်ပှၤအမါ, နဃၣ်ကွံာ်ယၤလၢမုၢ်တနံၤအံၤန့ၣ်အဘၣ်မနုၤအဃိလဲၣ်.",
  "21": "ယွၤဧၢ, ဟဲက့ၤကဒါက့ၤဆူပပူၤ, ဒီးပကဟဲက့ၤကဒါက့ၤလီၤ. ဒုးဟဲက့ၤကဒါက့ၤပနံၣ်တဖၣ်ဒ်လၢမုၢ်မဆါတနံၤအံၤအသိးလီၤ.",
  "22": "ယွၤဧၢ, နမၤသံပှၤကလီကလီလီၤ. နသးကညီၤပှၤကလီကလီလီၤ."
 },
