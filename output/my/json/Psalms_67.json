 "lang": "my",
 "verses": {
  "1": "သံစုံတီးဝိုင်းမှူးအတွက် \"Mizmor\" သီချင်းအတွက် သီချင်းတစ်ပုဒ်၊ သီချင်းတစ်ပုဒ်။",
  "2": "ဘုရားသခင်သည် အကျွန်ုပ်တို့ကို ကျေးဇူးပြု၍ ကောင်းကြီးပေးတော်မူပါစေသော။ မျက်နှာတော်ကို အကျွန်ုပ်တို့အပေါ်၌ ထွန်းလင်းစေတော်မူပါစေသော။",
  "3": "အိုထာဝရဘုရား၊ ကိုယ်တော်၏လမ်းကို လူမျိုးတို့သည် သိကြပါစေသော။ ကိုယ်တော်၏ ကယ်တင်တော်မူခြင်းကို မြေကြီးသားအပေါင်းတို့သည် သိကြပါစေသော။",
  "4": "အိုဘုရားသခင်၊ လူမျိုးတို့သည် ကိုယ်တော်ကို ချီးမွမ်းကြပါစေ။ လူမျိုးအပေါင်းတို့သည် ကိုယ်တော်ကို ချီးမွမ်းကြပါစေ။",
  "5": "ကိုယ်တော်သည် လူမျိုးတို့ကို ဖြောင့်မတ်စွာ စီရင် တော်မူ၍၊ မြေကြီးသားအပေါင်းတို့ကို လမ်းပြ တော်မူ၏။",
  "6": "အိုဘုရားသခင်၊ လူမျိုးတို့သည် ကိုယ်တော်ကို ချီးမွမ်းကြပါစေ။ လူမျိုးအပေါင်းတို့သည် ကိုယ်တော်ကို ချီးမွမ်းကြပါစေ။",
  "7": "မြေကြီးသည် အသီးအနှံကို ပေးသနားပြီ။ ဘုရားသခင်၊ ငါတို့ဘုရားသခင်သည် ကောင်းကြီးပေးတော်မူပါစေသော။",
  "8": "ဘုရားသခင်သည် အကျွန်ုပ်တို့ကို ကောင်းကြီးပေးတော်မူပါစေသော။ မြေကြီးစွန်းရှိသမျှတို့သည် ကြောက်ရွံ့ကြပါစေသော။"
 },
