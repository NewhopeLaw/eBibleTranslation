 "verses": {
  "1": "ထာဝရဘုရားကို ချီးမွမ်းကြလော့။ ငါတို့၏ ဘုရားသခင်ကို ချီးမွမ်းသီချင်းဆိုခြင်းသည် ကောင်း၏။ ချီးမွမ်းခြင်းသည် နှစ်လိုဖွယ်ကောင်း၏။",
  "2": "ထာဝရဘုရားသည် ယေရုရှလင်မြို့ကို တည်စေတော်မူ၏။ ဣသရေလအမျိုးနှင်ထုတ်ခြင်းကို စုဝေးစေတော်မူ၏။",
  "3": "ကျိုးပဲ့သောစိတ်ရှိသောသူတို့ကို ချမ်းသာပေး၍၊ သူတို့ဒဏ်ရာတို့ကို ချည်နှောင်တော်မူ၏။",
  "4": "[အောက်ခြေမှတ်ချက်]",
  "5": "ငါတို့ထာဝရဘုရားသည် ကြီးမြတ်တော်မူ၏။ တန်ခိုးကြီးတော်မူ၏။ ဥာဏ်တော်သည် အကန့်အသတ်မရှိ။",
  "6": "ထာဝရဘုရားသည် နှိမ့်ချသောသူတို့ကို မြှောက်တင်တော်မူ၏။ မတရားသောသူတို့ကို မြေကြီးပေါ်သို့ ချတော်မူ၏။",
  "7": "ကျေးဇူးတော်ကို ချီးမွမ်းလျက် ထာဝရဘုရားကို သီချင်းဆိုကြလော့။ တယောနှင့်တကွ ငါတို့ဘုရားသခင်ကို သီချင်းဆိုကြလော့။",
  "8": "မိုဃ်းတိမ်နှင့် မိုဃ်းကောင်းကင်ကို ဖုံးအုပ်တော်မူ၏။ မြေကြီးအဘို့ မိုဃ်းရေကို ပြင်ဆင်တော်မူ၏။ တောင်ပေါ်မှာ မြက်ပင်ကို ပေါက်စေတော်မူ၏။",
  "9": "တိရစ္ဆာန်များ၊ ငိုကြွေးသော ကောင်ငယ်တို့အား အစာကို ပေးတော်မူ၏။",
  "10": "မြင်း၏ခွန်အားကိုမနှစ်သက်။ လူ၏ခြေထောက်ကိုမနှစ်သက်။",
  "11": "ထာဝရဘုရားသည် ကိုယ်တော်ကို ကြောက်ရွံ့သောသူ၊ ကရုဏာတော်ကို မြော်လင့်သောသူတို့ကို နှစ်သက်တော်မူ၏။",
  "12": "အိုထာဝရဘုရား၊ ယေရုရှလင်မြို့ကို ချီးမွမ်းတော်မူပါ။ အို ဇိအုန်မြို့၊ သင်၏ ဘုရားသခင်ကို ချီးမွမ်းတော်မူပါ။",
  "13": "အကြောင်းမူကား၊ ကိုယ်တော်သည် သင်၏ တံခါးခွံတို့ကို ခိုင်ခံ့စေတော်မူ၏။ သင်၏ သားသမီးတို့ကို ကောင်းကြီးပေးတော်မူ၏။",
  "14": "သင်၏ နယ်နိမိတ်ကို ငြိမ်ဝပ်စွာ တည်စေတော်မူ၏။ အကောင်းဆုံးသော ဂျုံစပါးနှင့် သင့်ကို ဝစွာ ကျွေးတော်မူ၏။",
  "15": "မြေကြီးပေါ်မှာ ပညတ်တော်ကို စေလွှတ်တော်မူ၏။ နှုတ်ကပတ်တော်သည် အမြန်ပြေးတတ်၏။",
  "16": "နှင်းကိုသိုးမွေးကဲ့သို့၎င်း၊ ရေခဲကိုပြာကဲ့သို့၎င်းဖြန့်တော်မူ၏။",
  "17": "မိုဃ်းသီးကို ခဲကဲ့သို့ ပစ်တော်မူ၏။ အအေးတော်ရှေ့မှာ အဘယ်သူရပ်နိုင်သနည်း။",
  "18": "ပညတ်တော်ရှိလျှင် အရည်ပျော်စေတော်မူ၏။ လေတိုက်တော်မူလျှင် ရေစီးတတ်၏။",
  "19": "တရားတော်ကို ယာကုပ်အမျိုးအား၎င်း၊ ပညတ်တော်နှင့် စီရင်တော်မူချက်တို့ကို ဣသရေလအမျိုးအား၎င်း ဘော်ပြတော်မူ၏။",
  "20": "အခြားသောလူမျိုးတို့အား ထိုသို့မပြုတော်မမူ။ တရားတော်ကို မသိကြ။ ထာဝရဘုရားကို ချီးမွမ်းကြလော့။"
 },
