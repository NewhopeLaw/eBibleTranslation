<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and later says the same thing twice: once for a cloud backup
     and once for a phone-to-phone transfer. Both keep the reader's settings
     and leave the rebuildable caches behind. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="app_webview/Default/Code Cache" />
        <exclude domain="file" path="app_webview/Default/HTTP Cache" />
        <exclude domain="file" path="app_webview/Default/GPUCache" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="app_webview/Default/Code Cache" />
        <exclude domain="file" path="app_webview/Default/HTTP Cache" />
        <exclude domain="file" path="app_webview/Default/GPUCache" />
    </device-transfer>
</data-extraction-rules>
