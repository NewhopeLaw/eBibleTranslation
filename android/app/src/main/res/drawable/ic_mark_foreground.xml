<?xml version="1.0" encoding="utf-8"?>
<!-- An open book, two facing pages with the spine left as the gap between
     them, drawn on the 108dp adaptive canvas. What every launcher is
     guaranteed to show is not the 72dp square but the circle inside it, 66dp
     across: at full size the corners of the pages reached almost 39dp from the
     centre and a round mask clipped them. Scaled to 0.82 about the centre, the
     farthest corner sits under 32dp out, so no mask can cut a page off. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:pivotX="54"
        android:pivotY="54"
        android:scaleX="0.82"
        android:scaleY="0.82">
        <path
            android:pathData="M52,38 C45,32.5 35,29.5 24,29.5 L24,71.5 C35,71.5 45,74.5 52,80 Z"
            android:fillColor="@color/icon_page" />
        <path
            android:pathData="M56,38 C63,32.5 73,29.5 84,29.5 L84,71.5 C73,71.5 63,74.5 56,80 Z"
            android:fillColor="@color/icon_page" />
    </group>
</vector>
