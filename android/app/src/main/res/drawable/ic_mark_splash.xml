<?xml version="1.0" encoding="utf-8"?>
<!-- The same book for the splash, in the page's accent colour rather than on
     a coloured tile: the splash background is already the page's own, and the
     accent follows the phone into dark mode through values-night. The splash
     shows its icon through a circle two thirds of the canvas wide, so the book
     is drawn at the same reduced size as the launcher's (see
     ic_mark_foreground.xml). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:pivotX="54"
        android:pivotY="54"
        android:scaleX="0.82"
        android:scaleY="0.82">
        <path
            android:pathData="M52,38 C45,32.5 35,29.5 24,29.5 L24,71.5 C35,71.5 45,74.5 52,80 Z"
            android:fillColor="@color/page_accent" />
        <path
            android:pathData="M56,38 C63,32.5 73,29.5 84,29.5 L84,71.5 C73,71.5 63,74.5 56,80 Z"
            android:fillColor="@color/page_accent" />
    </group>
</vector>
