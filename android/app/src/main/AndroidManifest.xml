<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- No permissions at all, and INTERNET least of any: the whole Bible and
         its apparatus are in the APK, nothing is fetched and nothing is
         reported back. The absence of this line is the app's privacy policy in
         the only form a phone can check. -->

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:hardwareAccelerated="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.EBible.Splash">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:enableOnBackInvokedCallback="true"
            android:windowSoftInputMode="adjustResize"
            android:resizeableActivity="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode|density|fontScale|layoutDirection|locale">
            <!-- Turning the phone or folding it open must not throw the page
                 away: an eighteen-megabyte document takes a second or two to
                 parse, and the reader would lose their place every time. The
                 activity therefore rides out these changes itself, and hands
                 the WebView its own saved state when Android does kill the
                 process for real. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
