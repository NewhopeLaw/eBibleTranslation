# Copy this to keystore.properties (gitignored) on the machine that signs
# releases and fill it in there. Nothing here is ever committed: app/build.gradle
# simply leaves the release build unsigned when the file is absent, so a debug
# build still works on a machine that has no key.
storeFile=/absolute/path/to/ebible-release.jks
storePassword=
keyAlias=ebible
keyPassword=
