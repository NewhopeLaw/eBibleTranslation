# The assets are a copy of site/, put there by sync_assets.sh. They are eighty
# megabytes of text git already holds once, so they live in a working tree and
# never in a commit.
app/src/main/assets/

# Signing material. The keystore and its passwords stay on the machine that
# makes the release build; keystore.properties.example says what belongs in
# them.
keystore.properties
*.jks
*.keystore
