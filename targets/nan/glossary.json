    "רוח (ruach)": "看前後文：氣、風、神靈",
    "תהום (tehom)": "深淵",
    "תהו ובהו (tohu va-bohu)": "空虛混沌",
    "ברית (berit)": "約",
    "תורה (torah)": "教示／律法（看前後文）",
    "שלום (shalom)": "平安（看前後文嘛會使是「和平」「平安無事」）",
    "שאול (sheol)": "陰間"
  },
